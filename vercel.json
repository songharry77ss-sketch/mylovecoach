{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": {
    "api/coach.ts": {
      "maxDuration": 120,
      "memory": 1024,
      "supportsCancellation": true
    },
    "api/kkti-card.ts": {
      "maxDuration": 20,
      "memory": 1024,
      "includeFiles": "api/_assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/k",
      "destination": "/api/kkti-share"
    },
    {
      "source": "/k/:code",
      "destination": "/api/kkti-share?c=:code"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
