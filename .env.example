# ---- 앱 (Expo) : EXPO_PUBLIC_* 은 번들에 포함됩니다. 비밀키 금지 ----
# 코치 API 프록시 주소 (Vercel 배포 후 주소). 비우면 앱 내 '개인 API 키' 모드만 사용 가능
EXPO_PUBLIC_API_URL=https://mylovecoach.vercel.app
# 프록시가 COACH_APP_TOKEN을 요구할 때 같은 값을 넣어주세요 (선택)
EXPO_PUBLIC_API_TOKEN=
EXPO_PUBLIC_SUPPORT_EMAIL=support@mylovecoach.app
EXPO_PUBLIC_PRIVACY_URL=https://mylovecoach.vercel.app/privacy.html
EXPO_PUBLIC_TERMS_URL=https://mylovecoach.vercel.app/terms.html

# ---- 서버 (Vercel 환경변수로 등록) ----
# 둘 중 하나만 있어도 됩니다. 둘 다 있으면 AI_PROVIDER 로 선택 (기본 anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# COACH_APP_TOKEN=아무 긴 문자열 (선택, 앱과 동일하게)
