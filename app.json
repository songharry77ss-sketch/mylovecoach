{
  "expo": {
    "name": "나만의 연애코치",
    "slug": "mylovecoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mylovecoach",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#3DA0F2",
    "backgroundColor": "#FFFFFF",
    "description": "대화 캡처를 올리면 상대에게 딱 맞는 답장과 호감 온도를 알려주는 AI 연애 코치",
    "ios": {
      "bundleIdentifier": "app.mylovecoach.ios",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "연애코치",
        "NSPhotoLibraryUsageDescription": "대화 캡처와 상대 사진을 불러오기 위해 사진 보관함 접근 권한이 필요해요. 사진은 기기에만 저장되고 코칭 요청에만 사용돼요.",
        "NSCameraUsageDescription": "상대 프로필 사진을 촬영하기 위해 카메라 권한이 필요해요."
      }
    },
    "android": {
      "package": "app.mylovecoach.android",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EEF7FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "대화 캡처와 상대 사진을 불러오기 위해 사진 보관함 접근 권한이 필요해요.",
          "cameraPermission": "상대 프로필 사진을 촬영하기 위해 카메라 권한이 필요해요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF7FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F1419"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}
